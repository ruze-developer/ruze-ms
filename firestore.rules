rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function validName(n) { return n is string && n.size() > 0 && n.size() <= 64; }
    function spaceExists(id) { return exists(/databases/$(database)/documents/spaces/$(id)); }
    function roomData(id) { return get(/databases/$(database)/documents/rooms/$(id)).data; }
    function roomAccess(id) {
      return signedIn() && (
        (roomData(id).kind == 'channel' && spaceExists(roomData(id).spaceId)) ||
        (roomData(id).kind == 'dm' && request.auth.uid in roomData(id).members)
      );
    }
    match /profiles/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['displayName','createdAt'])
        && validName(request.resource.data.displayName);
      allow delete: if false;
    }
    match /spaces/{spaceId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['name','ownerId','createdAt'])
        && validName(request.resource.data.name)
        && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }
    match /rooms/{roomId} {
      allow read: if signedIn() && (
        (resource.data.kind == 'channel' && spaceExists(resource.data.spaceId)) ||
        (resource.data.kind == 'dm' && request.auth.uid in resource.data.members)
      );
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['name','kind','spaceId','members','createdBy','createdAt'])
        && validName(request.resource.data.name)
        && request.resource.data.createdBy == request.auth.uid
        && (
          (request.resource.data.kind == 'channel'
            && request.resource.data.spaceId is string
            && request.resource.data.members is list
            && request.resource.data.members.size() == 0
            && spaceExists(request.resource.data.spaceId)
            && get(/databases/$(database)/documents/spaces/$(request.resource.data.spaceId)).data.ownerId == request.auth.uid)
          ||
          (request.resource.data.kind == 'dm'
            && request.resource.data.spaceId == null
            && request.resource.data.members is list
            && request.resource.data.members.size() == 2
            && request.auth.uid in request.resource.data.members
            && request.resource.data.members[0] != request.resource.data.members[1]
            && roomId == 'dm_' + request.resource.data.members[0] + '_' + request.resource.data.members[1]
            && request.resource.data.members[0] < request.resource.data.members[1]
            && exists(/databases/$(database)/documents/profiles/$(request.resource.data.members[0]))
            && exists(/databases/$(database)/documents/profiles/$(request.resource.data.members[1])))
        );
      allow update, delete: if false;
      match /messages/{messageId} {
        allow read: if roomAccess(roomId);
        allow create: if roomAccess(roomId)
          && request.resource.data.keys().hasOnly(['body','senderId','createdAt'])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 4000
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }
  }
}
